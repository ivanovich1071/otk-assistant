# Скопируйте в .env и подставьте свой ключ. Файл .env в git не попадает.

# Ключ OpenRouter — https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Модель для чтения надписей (принимает изображения)
OPENROUTER_MODEL=qwen/qwen3.7-plus

# Модель для перепроверки сомнительных позиций
OPENROUTER_MODEL_STRONG=qwen/qwen3.8-max
