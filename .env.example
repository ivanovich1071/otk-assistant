# Скопируйте в .env и подставьте свой ключ. Файл .env в git не попадает.

# Ключ OpenRouter — https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Модель одна на весь проект — и на чтение, и на перепроверку.
# Дорогая max не используется: она вчетверо поднимала стоимость чертежа,
# а сомнительные позиции всё равно смотрит человек.
OPENROUTER_MODEL=qwen/qwen3.7-plus
